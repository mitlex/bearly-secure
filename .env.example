PAWPAL_API_KEY=replace_with_your_pawpal_api_key
APP_ORIGIN=http://localhost:3030
PORT=3030
ATTACKER_LAB_PORT=4040
DOWNLOAD_SIGNING_KEY=replace_with_64_hex_characters

# --- Trusted proxy configuration ---
# In production, Caddy terminates TLS and forwards requests to the app over
# loopback (127.0.0.1), so every request appears to come from Caddy over plain
# HTTP. Caddy passes along what it observed on the client's connection:
# X-Forwarded-For (the TCP peer IP), X-Forwarded-Proto (whether TLS was used),
# and X-Forwarded-Host (the requested host, which must match this site).
#
# Clients can also send these headers, but Caddy ignores them by default and
# reports what it saw on the connection. A client can lie in a header, but not
# easily about where its connection comes from. TRUST_PROXY_HOPS is the exact
# number of trusted proxies between the internet and the app:
#   0 = no trusted proxy. Ignore X-Forwarded-* and use the direct connection.
#       Use this for local development, where you hit the app directly.
#   1 = exactly one trusted proxy (Caddy). Trust only the entry Caddy added.
#       e.g. if a proxy appends to a client-sent header:
#         X-Forwarded-For: 1.2.3.4, 203.0.113.7
#                          ^ client ^ Caddy (real TCP peer): trust this one
#
# Too high: the app trusts client-written entries (e.g. a spoofed IP).
# Too low:  the app sees the proxy's IP instead of the real client's.
#
# Only use a non-zero value if the app's port is NOT publicly reachable.
# The app binds to ":PORT" (all interfaces), not just 127.0.0.1, so the
# "localhost" startup message doesn't mean loopback-only (see cmd/server/main.go).
# In production, make Caddy the only entry point by either:
#   - binding the app to 127.0.0.1, so only processes on the same machine
#     (like Caddy) can connect, or
#   - firewalling the app's port, so outside traffic can reach only
#     80/443, which Caddy owns.
# Otherwise clients can skip Caddy and forge headers directly (fake IPs to
# dodge rate limits or IP allowlists, fake hosts to poison password reset
# links). Negative values are rejected.
# Set to 1 only when every request passes through exactly one trusted proxy
TRUST_PROXY_HOPS=0
